# Único ponto de entrada. FABRICA_SITE_CADDY define o endereço:
#   ":80"                   HTTP puro (desenvolvimento e fumaça)
#   "fabrica.exemplo.com"   HTTPS automático (certificado do Let's Encrypt)
{$FABRICA_SITE_CADDY::80} {
	encode zstd gzip

	# Webhooks do GitHub e do GitLab: nunca em cache.
	handle /api/webhooks/* {
		header >Cache-Control "no-store"
		reverse_proxy backend:8000
	}

	# reverse_proxy já envia X-Forwarded-Proto/For/Host, descartando os valores vindos do cliente;
	# o Django lê o X-Forwarded-Proto quando FABRICA_URL_PUBLICA é https (SECURE_PROXY_SSL_HEADER).
	handle /api/* {
		reverse_proxy backend:8000
	}

	# /admin fica fora do ar por padrão: o Caddy não limita tentativas de login (o limite do app
	# vale só para /api/sessao/). Só com FABRICA_EXPOR_ADMIN=true, e de forma temporária.
	@admin {
		path /admin /admin/*
		expression "'{$FABRICA_EXPOR_ADMIN:false}' == 'true'"
	}
	handle @admin {
		reverse_proxy backend:8000
	}

	# /static/ (admin e DRF) é servido pelo próprio back-end com WhiteNoise;
	# o Caddy só encaminha, assim não há volume compartilhado entre as imagens.
	handle /static/* {
		reverse_proxy backend:8000
	}

	# Front-end: arquivos do dist; qualquer outra rota cai no index.html (SPA).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
