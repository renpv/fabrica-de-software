# Copie para .env e preencha. Nunca coloque valores reais neste arquivo.
DATABASE_URL=postgres://usuario:senha@localhost:5434/banco
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FABRICA_URL_PUBLICA=http://localhost:8000
# Quantos proxies confiáveis ficam na frente do app (0 = nenhum; atrás do Caddy, use 1).
# Define de onde vem o IP do cliente no limite de tentativas de login.
DJANGO_NUM_PROXIES=0
# Lista separada por vírgula. A primeira cifra; todas decifram (para trocar a chave, ponha a nova na frente).
# Gere uma com: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FABRICA_CHAVES_COFRE=

# --- Compose de produção (docker-compose.yml) ---
POSTGRES_USER=fabrica
POSTGRES_PASSWORD=
POSTGRES_DB=fabrica
# No compose, a DATABASE_URL é montada a partir das três acima (a de cima serve ao desenvolvimento local).
# Endereço do Caddy: ":80" (HTTP) ou o domínio, para HTTPS automático. Atrás do Caddy, DJANGO_NUM_PROXIES=1.
FABRICA_SITE_CADDY=:80
FABRICA_PORTA_HTTP=80
FABRICA_PORTA_HTTPS=443
# Pasta do collectstatic (opcional; padrão: backend/staticfiles).
# DJANGO_STATIC_ROOT=
