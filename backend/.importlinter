# Contratos de importação entre os módulos de apps/.
# Cada task que cria um módulo acrescenta aqui o contrato dele (ver CLAUDE.md):
#   cofre e donos      -> não importam nenhum outro módulo
#   agentes, plataformas -> só importam cofre e donos
#   fluxos             -> importa agentes (nunca saude, plataformas, projetos)
#   projetos           -> importa plataformas, fluxos, agentes, donos e cofre (nunca saude)
# Views e API só chamam servicos.py (a regra de negócio fica na camada de serviços).
[importlinter]
root_package = apps

[importlinter:contract:donos-isolado]
name = O módulo donos não importa nenhum outro módulo de apps
type = forbidden
source_modules =
    apps.donos
forbidden_modules =
    apps.saude
    apps.cofre
    apps.agentes
    apps.plataformas
    apps.projetos
    apps.fluxos
allow_indirect_imports = True

[importlinter:contract:saude-isolado]
name = O módulo saude não importa nenhum outro módulo de apps
type = forbidden
source_modules =
    apps.saude
forbidden_modules =
    apps.donos
    apps.cofre
    apps.agentes
    apps.plataformas
    apps.projetos
    apps.fluxos
allow_indirect_imports = True

[importlinter:contract:cofre-isolado]
name = O módulo cofre não importa nenhum outro módulo de apps
type = forbidden
source_modules =
    apps.cofre
forbidden_modules =
    apps.donos
    apps.saude
    apps.agentes
    apps.plataformas
    apps.projetos
    apps.fluxos
allow_indirect_imports = True

[importlinter:contract:agentes]
name = O módulo agentes só importa cofre e donos
type = forbidden
source_modules =
    apps.agentes
forbidden_modules =
    apps.saude
    apps.plataformas
    apps.projetos
    apps.fluxos
allow_indirect_imports = True

[importlinter:contract:fluxos]
name = O módulo fluxos só importa agentes, donos e cofre
type = forbidden
source_modules =
    apps.fluxos
forbidden_modules =
    apps.saude
    apps.plataformas
    apps.projetos
allow_indirect_imports = True

[importlinter:contract:plataformas]
name = O módulo plataformas só importa cofre e donos
type = forbidden
source_modules =
    apps.plataformas
forbidden_modules =
    apps.saude
    apps.agentes
    apps.projetos
    apps.fluxos
allow_indirect_imports = True

[importlinter:contract:projetos]
name = O módulo projetos só importa plataformas, agentes, donos e cofre
type = forbidden
source_modules =
    apps.projetos
forbidden_modules =
    apps.saude
allow_indirect_imports = True
